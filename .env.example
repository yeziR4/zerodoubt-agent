# From the dashboard: Rotate Secret (shown once). Never commit the real value.
AGENT_GAMES_HMAC_SECRET=
# Optional: Kurier mainnet key for the zkVerify audit trail.
KURIER_API_KEY=
PORT=8080
AGENT_PATH=/agent
# Must be a persistent volume in production: holds the proof-reuse set and answered tasks.
DATA_DIR=./data
# utf8 | sha256 | keccak256 — how a string task_id becomes the circuit's taskId signal.
TASK_ID_ENCODING=utf8
DEADLINE_MARGIN_MS=8000
